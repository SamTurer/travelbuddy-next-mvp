DATABASE_URL="file:./dev.db"

# Optional. Must-do parsing, planning, and Maps links all work with this unset.
# https://api.x.ai/v1  (OpenAI-compatible). Default model is grok-4.7.
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Set to true to let Grok rewrite stop descriptions. Titles and times stay put.
XAI_POLISH=
# Set to true to let Grok fill a slot the trusted list cannot. Labeled as an AI suggestion.
XAI_SUGGESTIONS=

# Optional. Live walking and transit times. Directions links do not need a key.
GOOGLE_MAPS_API_KEY=
